---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import Card from '../../components/Card.astro';
import GameCard from '../../components/GameCard.astro';
import Button from '../../components/Button.astro';
import ArrowLeft from '../../assets/icons/arrow-left.svg';
import { getDatabase } from '../../lib/db';
import { getAllPublishers, getGamesByPublisher, getPublisherById } from '../../lib/games';

export const prerender = true;

export const getStaticPaths = (async () => {
  const publishers = await getAllPublishers(getDatabase());
  return publishers.map((publisher) => ({ params: { id: String(publisher.id) } }));
}) satisfies GetStaticPaths;

const publisherId = Number(Astro.params.id);
const db = getDatabase();
const publisher = await getPublisherById(db, publisherId);
const games = await getGamesByPublisher(db, publisherId);

if (!publisher) {
  return Astro.redirect('/404');
}
---

<Layout title={`${publisher.name} - Tailspin Toys`}>
  <div class="py-8">
    <Card class="p-6" data-testid="publisher-details">
      <p class="text-sm font-medium uppercase tracking-wide text-purple-300">Publisher</p>
      <h1 class="mt-2 text-3xl font-bold text-slate-100" data-testid="publisher-name">{publisher.name}</h1>
      {publisher.description && (
        <p class="mt-4 max-w-3xl text-slate-400" data-testid="publisher-description">{publisher.description}</p>
      )}
    </Card>

    <section class="mt-8" aria-labelledby="publisher-games-heading">
      <h2 id="publisher-games-heading" class="mb-5 text-2xl font-medium text-slate-100">Games by {publisher.name}</h2>
      {games.length > 0 ? (
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="publisher-games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      ) : (
        <p class="text-slate-400" data-testid="publisher-empty">This publisher has no games yet.</p>
      )}
    </section>

    <div class="mt-8">
      <Button href="/" size="sm" data-testid="publisher-back-link">
        <ArrowLeft class="mr-2 h-5 w-5" aria-hidden="true" />
        Back to all games
      </Button>
    </div>
  </div>
</Layout>
